# Backend API Base URL
# Requests go through the Vite dev-server proxy (see vite.config.ts) to the
# FastAPI backend on :8008. Using a relative /api base keeps everything
# same-origin so the browser only needs port 5173 — this works through
# VS Code Remote / SSH forwarded ports where :8008 isn't directly reachable.
VITE_API_BASE_URL=/api
VITE_FASTAPI_BASE_URL=/api
